# Port the server listens on (Railway sets this automatically)
PORT=3000

# Secret key required in the "x-admin-key" header to access /api/admin/* routes.
# Change this to a strong random value before deploying.
ADMIN_KEY=admin123

# Path to the JSON data file used as the storage layer.
# Leave unset to default to ./data.json next to db.js.
# DATA_PATH=./data.json
